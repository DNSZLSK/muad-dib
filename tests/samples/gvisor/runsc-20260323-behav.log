#   runsc --network=host --strace --strace-syscalls=openat,open,connect,execve,execveat,clone,clone3,fork,vfork
#     --log-packets --debug-log=<dir>/ do -- <command below>
# /bin/sh -c "su nobody -s /bin/sh -c 'node /tmp/runsc-fx/prog.js behav ...'" (util-linux su: forks, the child execs the shell)
# prog.js: writes then reads <home>/.npmrc, reads /etc/os-release, /etc/passwd and a missing <home>/.ssh/id_rsa,
